    "SOURCE":"@EndUserText.label: 'Export Document Invoice Item'\r\n@Metadata.allowExtensions: true\r\n@AccessControl.authorizationCheck: #NOT_REQUIRED\r\ndefine view entity ZETR_DDL_C_EXP_INVI\r\n  as projection on ZETR_DDL_I_EXPORT_INVI\r\n{\r\n          @EndUserText.label: 'Dosya numarası'\r\n  key     filen,\r\n          @EndUserText.label: 'Faturalama belgesi'\r\n  key     vbeln,\r\n  key     BillingDocumentItem,\r\n          HigherLevelItem,\r\n          HigherLvlItmOfBatSpltItm,\r\n          Product,\r\n          BillingDocumentItemText,\r\n          BillingQuantity,\r\n          BillingQuantityUnit,\r\n          TransactionCurrency,\r\n          NetAmount,\r\n          TaxAmount,\r\n          Batch,\r\n          Plant,\r\n          PlantName,\r\n          StorageLocation,\r\n          StorageLocationName,\r\n          ShippingPoint,\r\n          ShippingPointName,\r\n          SalesDocument,\r\n          SalesDocumentItem,\r\n          ReferenceSDDocument,\r\n          ReferenceSDDocumentItem,\r\n          Subtotal1Amount,\r\n          Subtotal2Amount,\r\n          Subtotal3Amount,\r\n          Subtotal4Amount,\r\n          Subtotal5Amount,\r\n          Subtotal6Amount,\r\n\r\n          kunwe,\r\n          namwe,\r\n//          GCBNo,\r\n          CompanyCode,\r\n          CompanyCodeName,\r\n          ItemWeightUnit,\r\n          ItemNetWeight,\r\n          ItemVolumeUnit,\r\n          ItemVolume,\r\n          CustomerName,\r\n\r\n          @ObjectModel.virtualElementCalculatedBy: 'ABAP:ZETR_CL_EXP_VIRTUAL'\r\n          @EndUserText.label: 'GTIP No'\r\n  virtual gtipno    : abap.numc(18),\r\n          @ObjectModel.virtualElementCalculatedBy: 'ABAP:ZETR_CL_EXP_VIRTUAL'\r\n          @EndUserText.label: 'GTIP Alt No'\r\n  virtual gtipaltno : abap.numc(3),\r\n          @ObjectModel.virtualElementCalculatedBy: 'ABAP:ZETR_CL_EXP_VIRTUAL'\r\n          @EndUserText.label: 'GTIP Tanım'\r\n  virtual gtiptanim : abap.char(80),\r\n\r\n          Descr,\r\n          @ObjectModel.text.element: [ 'CustomerName' ]\r\n          Kunrg as kunrg,\r\n          Bldat,\r\n          erdat as erdat,\r\n          ernam as ernam,\r\n          clsed as clsed,\r\n          rexdt as rexdt,\r\n\r\n          @EndUserText.label: 'Beyanname'\r\n          invcedno,\r\n          @EndUserText.label: 'E-Fatura No'\r\n          invextfn,\r\n          invdiv,\r\n\r\n          _ExportFile : redirected to parent ZETR_DDL_C_EXP_HEADER\r\n}\r\n/*+[internal] {\n\"BASEINFO\":\n{\n\"FROM\":\n[\n\"ZETR_DDL_I_EXPORT_INVI\"\n],\n\"ASSOCIATED\":\n[\n\"ZETR_DDL_C_EXP_HEADER\",\n\"ZETR_DDL_I_EXP_HEAD\"\n],\n\"BASE\":\n[\n\"ZETR_DDL_I_EXPORT_INVI\"\n],\n\"ANNO_REF\":\n[],\n\"SCALAR_FUNCTION\":\n[],\n\"VERSION\":0,\n\"ANNOREF_EVALUATION_ERROR\":\"\"\n}\n}*/",
