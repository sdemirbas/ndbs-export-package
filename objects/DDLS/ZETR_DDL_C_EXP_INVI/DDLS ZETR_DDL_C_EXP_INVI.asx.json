    "SOURCE":"@EndUserText.label: 'Export Document Invoice Item'\n@Metadata.allowExtensions: true\n@AccessControl.authorizationCheck: #CHECK\ndefine view entity ZETR_DDL_C_EXP_INVI\n  as projection on ZETR_DDL_I_EXPORT_INVI\n{\n          @EndUserText.label: 'Dosya numarası'\n  key     filen,\n          @EndUserText.label: 'Faturalama belgesi'\n  key     vbeln,\n  key     BillingDocumentItem,\n          HigherLevelItem,\n          HigherLvlItmOfBatSpltItm,\n          Product,\n          BillingDocumentItemText,\n          BillingQuantity,\n          BillingQuantityUnit,\n          TransactionCurrency,\n          NetAmount,\n          TaxAmount,\n          Batch,\n          Plant,\n          PlantName,\n          StorageLocation,\n          StorageLocationName,\n          ShippingPoint,\n          ShippingPointName,\n          SalesDocument,\n          SalesDocumentItem,\n          ReferenceSDDocument,\n          ReferenceSDDocumentItem,\n          Subtotal1Amount,\n          Subtotal2Amount,\n          Subtotal3Amount,\n          Subtotal4Amount,\n          Subtotal5Amount,\n          Subtotal6Amount,\n\n          kunwe,\n          namwe,\n//          GCBNo,\n          CompanyCode,\n          CompanyCodeName,\n          ItemWeightUnit,\n          ItemNetWeight,\n          ItemVolumeUnit,\n          ItemVolume,\n          CustomerName,\n\n          @ObjectModel.virtualElementCalculatedBy: 'ABAP:ZETR_CL_EXP_VIRTUAL'\n          @EndUserText.label: 'GTIP No'\n  virtual gtipno    : abap.numc(18),\n          @ObjectModel.virtualElementCalculatedBy: 'ABAP:ZETR_CL_EXP_VIRTUAL'\n          @EndUserText.label: 'GTIP Alt No'\n  virtual gtipaltno : abap.numc(3),\n          @ObjectModel.virtualElementCalculatedBy: 'ABAP:ZETR_CL_EXP_VIRTUAL'\n          @EndUserText.label: 'GTIP Tanım'\n  virtual gtiptanim : abap.char(80),\n\n          Descr,\n          @ObjectModel.text.element: [ 'CustomerName' ]\n          Kunrg as kunrg,\n          Bldat,\n          erdat as erdat,\n          ernam as ernam,\n          clsed as clsed,\n          rexdt as rexdt,\n\n          @EndUserText.label: 'Beyanname'\n          invcedno,\n          @EndUserText.label: 'E-Fatura No'\n          invextfn,\n          invdiv,\n\n          _ExportFile : redirected to parent ZETR_DDL_C_EXP_HEADER\n}\n/*+[internal] {\n\"BASEINFO\":\n{\n\"FROM\":\n[\n\"ZETR_DDL_I_EXPORT_INVI\"\n],\n\"ASSOCIATED\":\n[\n\"ZETR_DDL_C_EXP_HEADER\",\n\"ZETR_DDL_I_EXP_HEAD\"\n],\n\"BASE\":\n[\n\"ZETR_DDL_I_EXPORT_INVI\"\n],\n\"ANNO_REF\":\n[],\n\"SCALAR_FUNCTION\":\n[],\n\"VERSION\":0,\n\"ANNOREF_EVALUATION_ERROR\":\"\"\n}\n}*/",
